# -----------------------------------------------------------------------------
# Our Cousin Family — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# -----------------------------------------------------------------------------

# --- Supabase (required) -----------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose with NEXT_PUBLIC_. Used only where a service-role
# client is unavoidable (none in M1 core; reserved for webhooks/admin jobs).
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Drive (Memory Vault) ---------------------------------------------
# These go on SUPABASE, not here — the Edge Functions are the only thing that
# reads them (supabase secrets set ...). They are listed for reference only;
# leaving them blank in .env.local is correct and safer.
#   supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... \
#     GOOGLE_REFRESH_TOKEN_ENCRYPTION_KEY=... SITE_URL=https://your-domain
# OAuth redirect URI (Google Cloud Console → Credentials → Authorised redirect
# URIs): https://<project-ref>.supabase.co/functions/v1/drive-oauth-callback
# Allowed scope: https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64-encoded 32-byte key. Encrypts the Drive refresh token at rest (AES-GCM)
# and signs the OAuth `state` value (HMAC). Changing it invalidates connections.
#   openssl rand -base64 32
GOOGLE_REFRESH_TOKEN_ENCRYPTION_KEY=

# --- LiveKit (Calls — Phase 6) -----------------------------------------------
# https://cloud.livekit.io → Project Settings
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Optional ----------------------------------------------------------------
# Outgoing email (Supabase Auth) uses the project's SMTP settings in the
# Supabase dashboard, not here.
