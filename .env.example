# -----------------------------------------------------------------------------
# Our Cousin Family — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# -----------------------------------------------------------------------------

# --- Supabase (required) -----------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose with NEXT_PUBLIC_. Used only where a service-role
# client is unavoidable (none in M1 core; reserved for webhooks/admin jobs).
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google OAuth (Memory Vault — Phase 5) -----------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI must include: {SITE_URL}/api/drive/callback
# Base64-encoded 32-byte key for encrypting refresh tokens at rest:
#   openssl rand -base64 32
GOOGLE_REFRESH_TOKEN_ENCRYPTION_KEY=

# --- LiveKit (Calls — Phase 6) -----------------------------------------------
# https://cloud.livekit.io → Project Settings
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Optional ----------------------------------------------------------------
# Outgoing email (Supabase Auth) uses the project's SMTP settings in the
# Supabase dashboard, not here.
